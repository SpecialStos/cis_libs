-- Real lint. `npm run lint`.
--
-- luacheck is not an npm dependency and is not installed by `npm ci`: CI
-- installs the pinned 1.2.0 release, so the library keeps its zero-runtime-
-- dependency property.
--
-- WHY TWO BLOCKS ARE GENERATED. The natives and runtime functions the shipped
-- code reads, and the globals the shipped code defines, are both facts about
-- the source rather than opinions, and both used to be hand-maintained. They
-- were hand-maintained badly enough that the globals block carried the single
-- entry "Cis.*" -- which luacheck cannot interpret as a pattern, so it matched
-- nothing and 1971 reads of the library's own globals were reported as
-- undefined. Both blocks are now generated by tools/gen-luacheck.js from the
-- native databases and from the source, and CI fails if they drift.

std = "lua54"

