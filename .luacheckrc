-- Everything below is a decision, not a default.

-- An unused LOCAL is the most useful thing this tool produces, and it is not
-- on by default. It stays on.
unused = true
unused_args = true

-- An argument named `_` is exempt, which is how a callback that has to match a
-- signature says so without silencing the rule for the whole file.
unused_secondaries = true

-- `self` in a method is a parameter, not a self-assignment.
self = false

-- W111 (setting an undefined global) and W113 (reading one) are on by default
-- and stay on. They are the rules that catch a misspelled native, which is a
-- runtime nil-index in a different subsystem entirely.
--
-- NOTE FOR THE NEXT EDITOR: the file previously set `undef`, `field`,
-- `mutating` and `shadowing` here, with comments explaining what each was for.
-- None of those is a luacheck 1.2.0 option. luacheck ignores keys it does not
-- recognise, so they did nothing at all and the comments described enforcement
-- that was not happening. Field access on a global table is deliberately not
-- reported: the library keeps its state in plain tables and reaches into them
-- by key.

-- Every file is linted. `exclude_files` used to hide client/cache.lua and
-- client/weapon.lua because they contain FiveM backtick hash literals, which
-- stock Lua cannot parse. tools/lint.js copies the tree to a temp folder and
-- replaces each backtick literal with a same-length placeholder, so those files
-- are checked like every other one and luacheck never sees the syntax it
-- cannot handle.

max_line_length = false
codes = true